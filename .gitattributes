* text=auto eol=lf

*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile* text eol=lf
*.sh text eol=lf
mvnw text eol=lf

*.ps1 text eol=crlf
*.cmd text eol=crlf
mvnw.cmd text eol=crlf

*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary

# Les régions Minecraft sont volumineuses et doivent passer par Git LFS.
dockerfiles/worlds/**/*.mca filter=lfs diff=lfs merge=lfs -text
