FROM itzg/mc-proxy:java25@sha256:54db442859713f661cf33b09d08b3ab088dd865550f43a9137c7b190978cdc4f AS upstream

# Rebuild the final metadata from scratch so the upstream VOLUME /server
# declaration cannot allocate a hidden anonymous volume below the tmpfs.
FROM scratch

COPY --from=upstream / /

ENV PATH=/opt/java/openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    JAVA_HOME=/opt/java/openjdk \
    LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8 \
    RCON_PORT=25575 \
    MEMORY=512m

WORKDIR /server

EXPOSE 25565 25577 19132/udp

HEALTHCHECK --start-period=10s CMD /usr/bin/health.sh

COPY --chown=1000:1000 dockerfiles/configs/Velocity                           /opt/tropicube/server/

COPY --chown=1000:1000 dockerfiles/configs/TropicubeVelocity                  /opt/tropicube/server/plugins/tropicube-velocity/

COPY --chown=1000:1000 dockerfiles/configs/Geyser-Velocity                    /opt/tropicube/server/plugins/Geyser-Velocity/

COPY --chown=1000:1000 dockerfiles/configs/floodgate                          /opt/tropicube/server/plugins/floodgate/

COPY --chown=1000:1000 dockerfiles/plugins/velocity                           /opt/tropicube/server/plugins/

# Official proxy plugins pinned to immutable builds and verified by BuildKit
# before they enter the image. Third-party JARs remain outside Git.
ADD --chown=1000:1000 --chmod=0644 --checksum=sha256:306abe38291d24e874c7286e1c04b537ac3ab5e3901b710f56bd242500bedfbf \
    https://download.geysermc.org/v2/projects/geyser/versions/2.11.3/builds/1245/downloads/velocity \
    /opt/tropicube/server/plugins/Geyser-Velocity.jar

ADD --chown=1000:1000 --chmod=0644 --checksum=sha256:f5867ad79b90d38abcc72755a685428fbcf423b52c9830a39ffed5203de6936a \
    https://download.geysermc.org/v2/projects/floodgate/versions/2.2.5/builds/140/downloads/velocity \
    /opt/tropicube/server/plugins/floodgate-velocity.jar

COPY --chmod=755 dockerfiles/velocity-entrypoint.sh                            /usr/local/bin/tropicube-velocity-entrypoint

ENTRYPOINT ["/usr/local/bin/tropicube-velocity-entrypoint"]

CMD ["/usr/bin/run-bungeecord.sh"]
