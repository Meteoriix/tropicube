ARG PAPER_VERSION=26.2
ARG PAPER_BUILD=97

FROM itzg/minecraft-server:java25@sha256:769a826c340586e9d483a0eb6437b8e2c3611aea6a115ff072a2fe372d43e2be AS paper-runtime
ARG PAPER_VERSION
ARG PAPER_BUILD
WORKDIR /opt/tropicube/paper
RUN mc-image-helper install-paper --version "${PAPER_VERSION}" --build "${PAPER_BUILD}" --output-directory . \
    && java -Dpaperclip.patchonly=true -jar "paper-${PAPER_VERSION}-${PAPER_BUILD}.jar"

FROM itzg/minecraft-server:java25@sha256:769a826c340586e9d483a0eb6437b8e2c3611aea6a115ff072a2fe372d43e2be
ARG PAPER_VERSION
ARG PAPER_BUILD

ENV TROPICUBE_PAPER_VERSION="${PAPER_VERSION}" \
    TROPICUBE_PAPER_BUILD="${PAPER_BUILD}"

COPY --from=paper-runtime --chown=1000:1000 /opt/tropicube/paper/ /data/
COPY --chown=1000:1000 dockerfiles/configs/paper-global.yml /data/config/paper-global.yml
COPY --chown=1000:1000 dockerfiles/configs/paper-world-defaults.yml /data/config/paper-world-defaults.yml
COPY --chown=1000:1000 dockerfiles/configs/bukkit.yml /data/bukkit.yml
COPY --chown=1000:1000 dockerfiles/configs/spigot.yml /data/spigot.yml
COPY --chown=1000:1000 dockerfiles/configs/TropicubeCore /data/plugins/TropicubeCore/
COPY --chown=1000:1000 dockerfiles/configs/TropicubeFallenKingdoms /data/plugins/TropicubeFallenKingdoms/
COPY --chown=1000:1000 dockerfiles/plugins/fallenkingdoms /data/plugins/
# The immutable map is copied into each ephemeral instance. Player/session files are excluded by the Docker context.
COPY --chown=1000:1000 dockerfiles/worlds/fallenkingdoms /data/world/
