# Copiez ce fichier vers .env et remplacez toutes les valeurs.
REDIS_PASSWORD=replace-with-a-long-random-secret
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-secret
MYSQL_DATABASE=tropicube_db
MYSQL_USER=tropicube_user
MYSQL_PASSWORD=replace-with-a-long-random-secret
FORWARDING_SECRET=replace-with-a-long-random-secret
RCON_PASSWORD=replace-with-a-long-random-secret
TOTP_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key

# Socket du daemon Docker. Pour Docker rootless, utilisez par exemple :
# /run/user/1000/docker.sock
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Service de traduction local facultatif (profil Compose language-editor).
LIBRETRANSLATE_PORT=5000
