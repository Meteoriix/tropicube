# Install as /etc/tropicube/ops.env with mode 0600; never store credentials in Git.
RESTIC_REPOSITORY=sftp:backup-host:/backups/tropicube
RESTIC_PASSWORD_FILE=/etc/tropicube/restic-password
# Configure backup-host, its key and verified host key in the service user's ~/.ssh/.
# Initialize the remote repository once using restic init before enabling the timer.
